# --- Senaryo (LLM) ---
# mistral | claude. Boşsa: MISTRAL_API_KEY varsa mistral, yoksa claude.
LLM_PROVIDER=mistral

# Mistral (önerilen senaryo sağlayıcısı)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_MAX_TOKENS=8192

# Claude (alternatif)
ANTHROPIC_API_KEY=

# --- Görsel (Gemini / Nano Banana Pro) ---
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_IMAGE_SIZE=2K

# --- Video: Runway / Veo 3.1 (OpenMontage) ---
# OpenMontage dizini (boşsa D:\OpenMontage, masaüstü veya kardeş dizin aranır)
OPENMONTAGE_PATH=D:\OpenMontage
# RUNWAY_API_KEY=...
# RUNWAYML_API_SECRET=...
# Veo (Google) için GEMINI_API_KEY yukarıdaki anahtarı kullanır.
# Sağlayıcı sırası: video_provider_policy.json
# Native ses modunda sahne üst süresi (sn): Veo 4/6/8 destekler
# NATIVE_MAX_SN=8

# --- Ekonomik mod: ElevenLabs seslendirme (yalnızca resim/hareketli modda) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Ücretsiz planda hazır sesler kısıtlıysa kendi voice_id'nizi verin:
# ELEVENLABS_VOICE_TR_KADIN=
# ELEVENLABS_VOICE_TR_ERKEK=

# --- Ekonomik mod: fal.ai hareketli video ---
# FAL_API_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video
# FAL_CLIP_DURATION=5

# --- FFmpeg ---
# FFMPEG_BIN_DIR=C:\ffmpeg-full_build\bin
